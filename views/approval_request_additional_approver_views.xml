<odoo>
    <record id="view_universal_additional_approver_wizard_form" model="ir.ui.view">
        <field name="name">universal.approval.additional.approver.wizard.form</field>
        <field name="model">universal_approval.additional_approver_wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="approval_request_id" readonly="1" invisible="1"/>
                        <field name="available_additional_config_line_ids" invisible="1"/>
                        
                        <field name="additional_config_line_ids"
                               widget="many2many_checkboxes"
                               domain="[('id', 'in', available_additional_config_line_ids)]"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </sheet>
    
                <footer>
                    <button name="action_approve_without_add"
                            type="object"
                            string="Approve Without Adding"
                            class="btn-primary"/>
                
                    <button name="action_add_and_approve"
                            type="object"
                            string="Add &amp; Approve"
                            class="btn-primary"/>
                
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>