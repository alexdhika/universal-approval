<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_approval_config_form" model="ir.ui.view">
        <field name="name">approval.config.form</field>
        <field name="model">universal_approval.config</field>
        <field name="arch" type="xml">
            <form string="Approval Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Rule Name (e.g. PO High Amount Approval)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="allowed_model_ids" invisible="1"/>
                            <field name="model_name" invisible="1"/>
                            <field name="reject_behavior"/>
                            <!-- <field name="sequence"/> -->
                            <field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <group string="Filter Rule Domain">
                        <field name="domain" widget="domain" options="{'model': 'model_name'}"/>
                        <!-- <button name="tes_cek_inherit_model" type="object" string="Test Inherit Models" class="btn-primary"/> -->
                    </group>
                    <notebook>
                        <page string="Approver Levels (Sequential)" name="approvers">
                            <field name="approver_line_ids">
                                <list>
                                    <!-- Handle untuk drag and drop urutan sequence -->
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="show_return_button"/>
                                    <field name="allow_add_additional_approvers"/>
                                    <field name="is_additional_approver"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="config_id" readonly="1"/>
                                                <field name="user_id"
                                                        options="{'no_create': True, 'no_open': True}"/>
                                                <field name="show_return_button"/>
                                                <field name="allow_add_additional_approvers"/>
                                            </group>
                                            <group>
                                                <field name="is_additional_approver"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Notification Settings" name="notifications">
                            <group>
                                <field name="approved_notify_user_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                                <field name="rejected_notify_user_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_approval_config_tree" model="ir.ui.view">
        <field name="name">approval.config.tree</field>
        <field name="model">universal_approval.config</field>
        <field name="arch" type="xml">
            <list string="Approval Configurations">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="reject_behavior"
                       widget="badge"
                       decoration-danger="reject_behavior == 'stop'"
                       decoration-success="reject_behavior == 'resume'"
                       decoration-info="reject_behavior == 'restart'"/>
                <field name="approver_line_ids"/>
            </list>
        </field>
    </record>

    <!-- search -->
    <record id="view_approval_config_search" model="ir.ui.view">
        <field name="name">approval.config.search</field>
        <field name="model">universal_approval.config</field>
        <field name="arch" type="xml">
            <search string="Approval Config">
                <field name="name"/>

                <searchpanel>
                    <field
                        name="model_id"
                        string="Model"
                    />
            
                    <field
                        name="category_id"
                        string="Category"
                    />

                    <field
                        name="tag_ids"
                        string="Tags"
                        select="multi"
                        widget="many2many_tags"
                    />
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action & Menu -->
    <record id="action_approval_config" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">universal_approval.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            {
                'search_default_group_by_model': 1,
                'search_default_group_by_tags': 1,
            }
        </field>
    </record>

</odoo>